# Rockchip RK3588 PREEMPT_RT 基线配置（分支默认实时优化集, 6.1 线）
#
# 分层设计（ADR-011）:
#   本文件 = 安全延迟基线——任何使用本分支的构建都应携带, 只含无争议的延迟优化
#   用例级差异（延迟诊断器 / 安全缓解策略等）由编译仓 kernel/fragments/ 覆盖
# 来源: 官方 rockchip_rt.config + kernel.org 6.1.177-rt65 + 深度实时化（2026-10-01）
# 变更: 修复 NO_HZ_FULL 缺失（cmdline nohz_full= 此前被静默忽略）; 移除
#       HZ_PERIODIC（与 NO_HZ_FULL 互斥）; 补 RCU_BOOST/IRQ_FORCED_THREADING/THP_MADVISE

# ---- 抢占与时钟 ----
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_FULL=y            # 配合 cmdline nohz_full= 隔离核停 tick
CONFIG_HIGH_RES_TIMERS=y
CONFIG_RCU_BOOST=y             # RCU 读端持有者优先级提升, 防优先级反转
CONFIG_IRQ_FORCED_THREADING=y  # cmdline threadirqs 的编译期前提
CONFIG_JUMP_LABEL=y

# ---- 频率/功耗（关 DVFS 与 idle 唤醒延迟） ----
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# CONFIG_CPU_FREQ_TIMES is not set
# CONFIG_CPU_FREQ_THERMAL is not set
# CONFIG_ARM_PSCI_CPUIDLE is not set
# CONFIG_ARM_ROCKCHIP_DMC_DEVFREQ is not set

# ---- 内存（关换页/压缩/整理/迁移停顿; 6.1 保留 vendor 的 MIGRATION 关停） ----
# CONFIG_SWAP is not set
# CONFIG_ZRAM is not set
# CONFIG_COMPACTION is not set
# CONFIG_MIGRATION is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y   # THP 仅显式 madvise, 避免后台整理停顿

# ---- 安全缓解（6.1 vendor 关停项, 换取分支预测/栈虚拟化开销; 单用途设备取向） ----
# CONFIG_ARM_PATCH_PHYS_VIRT is not set
# CONFIG_ARCH_MULTIPLATFORM is not set
# CONFIG_VMAP_STACK is not set
# CONFIG_HARDEN_BRANCH_PREDICTOR is not set
# CONFIG_HARDEN_BRANCH_HISTORY is not set

# ---- 观测/调试开销（延迟优先全关; 诊断由编译仓覆盖层按需开启） ----
# CONFIG_FTRACE is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_PROFILING is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SCHED_INFO is not set
# CONFIG_IRQ_TIME_ACCOUNTING is not set
# CONFIG_PSI is not set
# CONFIG_TASKSTATS is not set
# CONFIG_CGROUP_CPUACCT is not set
# CONFIG_CGROUP_SCHED is not set
# CONFIG_MALI_BIFROST_ENABLE_TRACE is not set
# CONFIG_MALI_BIFROST_SYSTEM_TRACE is not set
