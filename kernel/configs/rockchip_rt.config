# Rockchip RK3588 PREEMPT_RT 基线配置（分支默认实时优化集）
#
# 分层设计（ADR-011）:
#   本文件 = 安全延迟基线——任何使用本分支的构建都应携带, 只含无争议的延迟优化
#   用例级差异（延迟诊断器 / 安全缓解策略等）由编译仓 kernel/fragments/ 覆盖
# 来源: 官方 rockchip_rt.config 适配 6.12 + 深度实时化（机器人/无人机, 2026-10-01）
# 变更: 移除 HZ_PERIODIC（与 NO_HZ_FULL 互斥, 官方原件自相矛盾）; 新增
#       RCU_BOOST/IRQ_FORCED_THREADING/THP_MADVISE 显式项
# 格式纪律: 注释独占行——CONFIG 行内注释经 merge/kconfig 链行为不确定（实测
#       THP_MADVISE 曾因此静默丢弃）

# ---- 抢占与时钟 ----
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
# 配合 cmdline nohz_full= 隔离核停 tick
CONFIG_NO_HZ_FULL=y
CONFIG_HIGH_RES_TIMERS=y
# RCU 读端持有者优先级提升, 防优先级反转
CONFIG_RCU_BOOST=y
# cmdline threadirqs 的编译期前提
CONFIG_IRQ_FORCED_THREADING=y
CONFIG_JUMP_LABEL=y

# ---- 频率/功耗（关 DVFS 与 idle 唤醒延迟） ----
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# CONFIG_ARM_PSCI_CPUIDLE is not set
# CONFIG_ARM_ROCKCHIP_DMC_DEVFREQ is not set
# CONFIG_CPU_FREQ_THERMAL is not set

# ---- 内存（关换页/压缩/迁移停顿） ----
# CONFIG_SWAP is not set
# CONFIG_ZRAM is not set
# CONFIG_COMPACTION is not set
# THP 仅显式 madvise（defconfig 默认 always 是后台整理停顿源）
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# ---- 观测/调试开销（延迟优先全关; 诊断由编译仓覆盖层按需开启） ----
# CONFIG_FTRACE is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SCHED_INFO is not set
# CONFIG_IRQ_TIME_ACCOUNTING is not set
# CONFIG_PSI is not set
# CONFIG_TASKSTATS is not set
# CONFIG_CGROUP_CPUACCT is not set
# CONFIG_CGROUP_SCHED is not set
# CONFIG_MALI_BIFROST_ENABLE_TRACE is not set
# CONFIG_MALI_BIFROST_SYSTEM_TRACE is not set
